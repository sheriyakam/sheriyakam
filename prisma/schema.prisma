datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  baseResume      BaseResume?
  linkedinProfile LinkedinProfile?
  credits         CreditBalance[]
  creditUsages    CreditUsage[]
  payments        Payment[]
  llmCallLogs     LlmCallLog[]
}

model BaseResume {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact        Json
  summary        String?           @db.Text
  experience     Json
  education      Json
  skills         String[]
  projects       Json?
  certifications Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       TailoredVersion[]
}

model JobDescription {
  id                String            @id @default(cuid())
  userId            String
  rawText           String            @db.Text
  title             String?
  company           String?
  seniorityLevel    String?
  requiredSkills    String[]
  preferredSkills   String[]
  extractedKeywords String[]
  createdAt         DateTime          @default(now())
  versions          TailoredVersion[]
}

model TailoredVersion {
  id               String         @id @default(cuid())
  baseResumeId     String
  baseResume       BaseResume     @relation(fields: [baseResumeId], references: [id], onDelete: Cascade)
  jobDescriptionId String
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  content          Json
  initialScore     Int?
  atsScore         Int
  keywordMatches   String[]
  keywordGaps      String[]
  templateId       String         @default("standard")
  createdAt        DateTime       @default(now())
}

model LinkedinProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline          String?
  about             String?  @db.Text
  experience        Json?
  skills            String[]
  completenessScore Int?
  updatedAt         DateTime @updatedAt
}

model CreditBalance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packType    String    // 'free', 'lite', 'active_search'
  creditsLeft Int
  expiresAt   DateTime? // null for free, or 30 days for paid packs
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model CreditUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType  String   // 'tailor', 'ats_check', 'cover_letter', 'refinement'
  packType    String   // 'free', 'lite', 'active_search'
  consumedAt  DateTime @default(now())

  @@index([userId, actionType, consumedAt])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Int
  currency          String   @default("INR")
  provider          String   @default("razorpay")
  status            String   // 'pending', 'success', 'failed'
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())
}

model LlmCallLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         String   // 'gemini', 'openrouter', 'groq'
  model            String
  endpoint         String?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  status           String   // 'success', 'error', 'fallback'
  errorMessage     String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([provider, status])
  @@index([createdAt])
}
