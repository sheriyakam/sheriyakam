datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  baseResume      BaseResume?
  linkedinProfile LinkedinProfile?
  credits         CreditBalance[]
  payments        Payment[]
}

model BaseResume {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact        Json
  summary        String?
  experience     Json
  education      Json
  skills         String[]
  projects       Json?
  certifications Json?
  updatedAt      DateTime          @updatedAt
  versions       TailoredVersion[]
}

model JobDescription {
  id                String            @id @default(cuid())
  userId            String
  rawText           String            @db.Text
  title             String?
  company           String?
  extractedKeywords String[]
  createdAt         DateTime          @default(now())
  versions          TailoredVersion[]
}

model TailoredVersion {
  id               String         @id @default(cuid())
  baseResumeId     String
  baseResume       BaseResume     @relation(fields: [baseResumeId], references: [id], onDelete: Cascade)
  jobDescriptionId String
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  content          Json
  atsScore         Int
  keywordMatches   String[]
  keywordGaps      String[]
  templateId       String
  createdAt        DateTime       @default(now())
}

model LinkedinProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline          String?
  about             String?  @db.Text
  experience        Json?
  skills            String[]
  completenessScore Int?
  updatedAt         DateTime @updatedAt
}

model CreditBalance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packType    String
  creditsLeft Int
  expiresAt   DateTime
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  provider  String
  status    String
  createdAt DateTime @default(now())
}
