# ==============================================================================
# Sheriyakam AI Resume & LinkedIn Optimizer - Environment Variables
# ==============================================================================

# 1. Primary LLM: Google Gemini 2.5 Flash (Used for Tailoring, Rewriting, LinkedIn)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Fallback LLM: OpenRouter Free Pool (Activated silently on 429 / quota limit)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
NEXT_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Fast Subtask LLM: Groq Cloud (Used for fast keyword extraction and scoring)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# 4. Razorpay Payments (Used for Lite Pack $2 and Active Search Pack $5 checkout)
# Get test/live keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# 5. PostgreSQL Database via Prisma (Neon / Supabase / Railway / Local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/sheriyakam?schema=public"

# 6. Base Application URL
NEXT_PUBLIC_APP_URL="https://sheriyakam.vercel.app"
